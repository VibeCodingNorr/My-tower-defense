[configuration]
entry_symbol = "wintertd_library_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]
linux.debug.x86_64 = "res://bin/wintertd.so"
linux.release.x86_64 = "res://bin/wintertd.so"
windows.debug.x86_64 = "res://bin/wintertd.dll"
windows.release.x86_64 = "res://bin/wintertd.dll"
macos.debug = "res://bin/wintertd.dylib"
macos.release = "res://bin/wintertd.dylib"
